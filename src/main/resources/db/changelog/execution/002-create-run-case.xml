<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <changeSet id="002-create-run-case" author="simulation-workbench">
    <createTable tableName="run_case">
      <column name="case_id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="run_id" type="UUID">
        <constraints nullable="false" foreignKeyName="fk_run_case_run" references="run(run_id)"
                     deleteCascade="true"/>
      </column>
      <column name="case_key" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="ordinal" type="INTEGER">
        <constraints nullable="false"/>
      </column>
      <column name="variant_label" type="VARCHAR(120)">
        <constraints nullable="false"/>
      </column>
      <column name="seed" type="VARCHAR(20)">
        <constraints nullable="false"/>
      </column>
      <column name="player_count" type="INTEGER">
        <constraints nullable="false"/>
      </column>
      <column name="seats_json" type="TEXT">
        <constraints nullable="false"/>
      </column>
      <column name="state" type="VARCHAR(16)">
        <constraints nullable="false"/>
      </column>
      <column name="result_json" type="TEXT"/>
    </createTable>

    <!-- A logical case exists once per run: attempts recover it, they never duplicate it. -->
    <addUniqueConstraint tableName="run_case" columnNames="run_id, case_key"
                         constraintName="uq_run_case_key"/>
    <createIndex tableName="run_case" indexName="run_case_by_state_idx">
      <column name="run_id"/>
      <column name="state"/>
      <column name="ordinal"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
