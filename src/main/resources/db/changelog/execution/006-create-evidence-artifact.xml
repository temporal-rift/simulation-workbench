<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <changeSet id="006-create-evidence-artifact" author="simulation-workbench">
    <!-- Content-addressed, protected artifacts: pinned manifests, transcripts and raw event payloads. -->
    <createTable tableName="evidence_artifact">
      <column name="digest" type="VARCHAR(64)">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="media_type" type="VARCHAR(100)">
        <constraints nullable="false"/>
      </column>
      <column name="content" type="BYTEA">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

</databaseChangeLog>
