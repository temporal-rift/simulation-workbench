<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <changeSet id="001-create-run" author="simulation-workbench">
    <createTable tableName="run">
      <column name="run_id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="experiment_id" type="UUID">
        <constraints nullable="false" foreignKeyName="fk_run_experiment" references="experiment(experiment_id)"/>
      </column>
      <column name="state" type="VARCHAR(16)">
        <constraints nullable="false"/>
      </column>
      <!-- Frozen at start from the manifest so a claim can enforce the bound in one statement. -->
      <column name="concurrency" type="INTEGER">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
      <column name="started_at" type="TIMESTAMP WITH TIME ZONE"/>
      <column name="finished_at" type="TIMESTAMP WITH TIME ZONE"/>
      <column name="failure_code" type="VARCHAR(32)"/>
      <column name="failure_message" type="TEXT"/>
    </createTable>

    <createIndex tableName="run" indexName="run_by_state_idx">
      <column name="state"/>
      <column name="created_at"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
