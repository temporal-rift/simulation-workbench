<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <changeSet id="005-create-run-command" author="simulation-workbench">
    <createTable tableName="run_command">
      <column name="idempotency_key" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="operation" type="VARCHAR(16)">
        <constraints nullable="false"/>
      </column>
      <column name="run_id" type="UUID">
        <constraints nullable="false" foreignKeyName="fk_run_command_run" references="run(run_id)"
                     deleteCascade="true"/>
      </column>
      <column name="request_hash" type="VARCHAR(64)">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

</databaseChangeLog>
