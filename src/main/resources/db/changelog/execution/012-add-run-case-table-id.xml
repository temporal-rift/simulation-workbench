<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <changeSet id="012-add-run-case-table-id" author="simulation-workbench">
    <!-- The seat table whose policies play the case. -->
    <addColumn tableName="run_case">
      <column name="table_id" type="VARCHAR(63)"/>
    </addColumn>
    <!--
      A case recorded before seat tables played its one policy on every seat, which is a uniform table named for that
      policy, so the table of a stored case is the policy of its first seat.
    -->
    <sql>UPDATE run_case SET table_id = (CAST(seats_json AS JSONB) -> 0 ->> 'policyId')</sql>
    <addNotNullConstraint tableName="run_case" columnName="table_id" columnDataType="VARCHAR(63)"/>
  </changeSet>
</databaseChangeLog>
