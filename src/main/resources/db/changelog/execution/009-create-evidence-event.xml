<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <changeSet id="009-create-evidence-event" author="simulation-workbench">
    <!-- Raw events deduplicated by source and event identifier. Partition and offset locate a record within
         its source only; nothing here orders events across sources. -->
    <createTable tableName="evidence_event">
      <column name="scope_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="game_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="source" type="VARCHAR(249)">
        <constraints nullable="false"/>
      </column>
      <column name="event_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="attempt_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="event_type" type="VARCHAR(100)">
        <constraints nullable="false"/>
      </column>
      <column name="aggregate_id" type="UUID"/>
      <column name="aggregate_type" type="VARCHAR(100)"/>
      <column name="occurred_at" type="TIMESTAMP WITH TIME ZONE"/>
      <column name="version" type="INTEGER"/>
      <column name="partition_no" type="INTEGER">
        <constraints nullable="false"/>
      </column>
      <column name="offset_no" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="payload_artifact" type="VARCHAR(64)">
        <constraints nullable="false" foreignKeyName="fk_event_payload" references="evidence_artifact(digest)"/>
      </column>
      <column name="observed_at" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addPrimaryKey tableName="evidence_event" columnNames="scope_id, game_id, source, event_id"
                   constraintName="pk_evidence_event"/>

    <createTable tableName="evidence_source_offset">
      <column name="scope_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="game_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="source" type="VARCHAR(249)">
        <constraints nullable="false"/>
      </column>
      <column name="partition_no" type="INTEGER">
        <constraints nullable="false"/>
      </column>
      <column name="next_offset" type="BIGINT">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addPrimaryKey tableName="evidence_source_offset"
                   columnNames="scope_id, game_id, source, partition_no"
                   constraintName="pk_evidence_source_offset"/>
  </changeSet>

</databaseChangeLog>
