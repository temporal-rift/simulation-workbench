<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <changeSet id="002-create-campaign-candidate" author="simulation-workbench">
    <createTable tableName="campaign_candidate">
      <column name="campaign_id" type="UUID">
        <constraints nullable="false" foreignKeyName="fk_campaign_candidate_campaign" references="campaign(campaign_id)"/>
      </column>
      <column name="candidate_id" type="VARCHAR(16)">
        <constraints nullable="false"/>
      </column>
      <column name="round" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="point_json" type="TEXT">
        <constraints nullable="false"/>
      </column>
      <column name="overrides_json" type="TEXT">
        <constraints nullable="false"/>
      </column>
      <column name="effective_rules_digest" type="VARCHAR(64)">
        <constraints nullable="false"/>
      </column>
      <column name="redraws" type="INT">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <addPrimaryKey tableName="campaign_candidate" columnNames="campaign_id, candidate_id"
                   constraintName="pk_campaign_candidate"/>
    <!-- A campaign never holds two candidates with the same effective rules. -->
    <addUniqueConstraint tableName="campaign_candidate" columnNames="campaign_id, effective_rules_digest"
                         constraintName="uq_campaign_candidate_digest"/>
  </changeSet>
</databaseChangeLog>
