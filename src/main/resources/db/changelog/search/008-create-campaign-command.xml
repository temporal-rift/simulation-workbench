<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <changeSet id="008-create-campaign-command" author="simulation-workbench">
    <!-- Every idempotency key a campaign request claimed, creating a campaign or commanding one, so a key has one owner. -->
    <createTable tableName="campaign_command">
      <column name="idempotency_key" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="campaign_id" type="UUID">
        <constraints nullable="false" foreignKeyName="fk_campaign_command_campaign" references="campaign(campaign_id)"
                     deleteCascade="true"/>
      </column>
      <column name="request_hash" type="VARCHAR(64)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <sql>
      INSERT INTO campaign_command (idempotency_key, campaign_id, request_hash)
      SELECT idempotency_key, campaign_id, request_hash FROM campaign
    </sql>
  </changeSet>
</databaseChangeLog>
