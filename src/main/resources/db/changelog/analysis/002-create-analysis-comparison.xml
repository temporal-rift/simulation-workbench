<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <changeSet id="002-create-analysis-comparison" author="simulation-workbench">
    <!-- A comparison is stored as its definition; its numbers are recomputed from current case results. -->
    <createTable tableName="analysis_comparison">
      <column name="comparison_id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="idempotency_key" type="UUID">
        <constraints nullable="false" unique="true" uniqueConstraintName="uq_analysis_comparison_key"/>
      </column>
      <column name="request_hash" type="VARCHAR(64)">
        <constraints nullable="false"/>
      </column>
      <column name="baseline_run_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="baseline_variant" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="candidate_run_id" type="UUID">
        <constraints nullable="false"/>
      </column>
      <column name="candidate_variant" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="declared_differences" type="TEXT">
        <constraints nullable="false"/>
      </column>
      <column name="analysis_version" type="VARCHAR(32)">
        <constraints nullable="false"/>
      </column>
      <column name="analysis_seed" type="VARCHAR(20)">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

</databaseChangeLog>
