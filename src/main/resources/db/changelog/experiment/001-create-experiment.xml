<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

  <changeSet id="001-create-experiment" author="simulation-workbench">
    <createTable tableName="experiment">
      <column name="experiment_id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="manifest_digest" type="VARCHAR(64)">
        <constraints nullable="false"/>
      </column>
      <column name="manifest_json" type="TEXT">
        <constraints nullable="false"/>
      </column>
      <column name="name" type="VARCHAR(120)">
        <constraints nullable="false"/>
      </column>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <createIndex tableName="experiment" indexName="experiment_by_manifest_digest_idx">
      <column name="manifest_digest"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
